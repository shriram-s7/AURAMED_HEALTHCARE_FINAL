DATABASE_URL=postgresql://user:password@localhost:5432/auramed
SECRET_KEY=your-secret-key-min-32-chars-auramed-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

BREAST_MODEL_PATH=app/ml/weights/breast_model.pth
CERVICAL_MODEL_PATH=app/ml/weights/cervical_model.pth
PCOS_MODEL_PATH=app/ml/weights/pcos_model.pth

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@auramed.in
FROM_NAME=AuraMed

# Real recall messaging (keep actual credentials in backend/.env; use a Twilio sender/service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
# Legacy alias; TWILIO_PHONE_NUMBER takes precedence.
TWILIO_FROM_NUMBER=
TWILIO_SMS_TRIAL_MODE=false
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=whatsapp:+12345678900
TWILIO_WHATSAPP_CONTENT_SID=HX...

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
PATIENT_PORTAL_URL=http://localhost:5173/patient

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
